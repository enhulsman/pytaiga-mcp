# Taiga MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================================
# TRANSPORT MODE
# ============================================================
# "stdio" (default, for Claude Code CLI) or "streamable-http" (for Claude Teams)
TAIGA_TRANSPORT=stdio

# ============================================================
# TAIGA CONNECTION
# ============================================================
# Taiga API base URL
TAIGA_API_URL=http://localhost:9000

# ============================================================
# STDIO MODE: Auto-Authentication
# ============================================================
# When set, the server auto-authenticates and creates a "default" session.
# Only used in stdio mode. Not needed in OAuth mode.
TAIGA_USERNAME=your_username
TAIGA_PASSWORD=your_password

# ============================================================
# OAUTH MODE: Auth0 Configuration (streamable-http only)
# ============================================================
# Auth0 tenant URL (e.g., https://your-tenant.auth0.com/)
# OAUTH_ISSUER_URL=https://anamata.auth0.com/

# MCP server resource identifier / audience
# OAUTH_AUDIENCE=https://taiga-mcp.hulsman.dev

# Required OAuth scopes (comma-separated)
# OAUTH_REQUIRED_SCOPES=taiga:read,taiga:write

# Expected token lifetime in seconds (default 900 = 15 min)
# OAUTH_TOKEN_LIFETIME=900

# JWKS cache duration in seconds (default 600 = 10 min)
# JWKS_CACHE_TTL=600

# ============================================================
# CREDENTIAL STORE (OAuth mode)
# ============================================================
# Fernet encryption key for stored Taiga tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TAIGA_CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here

# Path to credential store SQLite database
# TAIGA_CREDENTIAL_STORE_PATH=~/.taiga-mcp/credentials.db

# ============================================================
# BROWSER LINKING FLOW (OAuth mode)
# ============================================================
# Auth0 application for the browser-based Taiga account linking flow
# OAUTH_LINK_CLIENT_ID=your-auth0-linking-app-client-id
# OAUTH_LINK_CLIENT_SECRET=your-auth0-linking-app-client-secret

# Session cookie TTL for linking flow (default 600 = 10 min)
# LINK_SESSION_TTL=600
